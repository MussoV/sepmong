# Copiar a .env y reemplazar los valores. NUNCA subir .env a git.
# Generar contraseñas con:  openssl rand -base64 32 | tr -d '/+=' | head -c 32

# Usuario administrador de Mongo (solo para administración y backups)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CAMBIAR

# Base y usuario de la aplicación (rol semilleroApp, mínimo privilegio)
APP_DB_NAME=semillero
APP_DB_USER=semillero_app
APP_DB_PASSWORD=CAMBIAR

# Primer administrador del panel (debe ser @uniandes.edu.co).
# Solo se usa en el primer arranque; los demás se autorizan desde el panel.
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_NOMBRE=
